{
  "workflow": {
    "name": "Multi-Agent Delegation System",
    "version": "1.0.0",
    "enabled": true,
    "description": "Enforces delegation to Gemini (analysis) and Qwen (generation) based on task specialty"
  },
  "agents": {
    "claude": {
      "role": "orchestrator",
      "responsibilities": [
        "Task understanding and breakdown",
        "Agent coordination and delegation",
        "Answer validation and merging",
        "Conflict resolution",
        "Final implementation planning",
        "File operations (Read/Write/Edit)"
      ],
      "capabilities": [
        "file_operations",
        "workflow_management",
        "validation",
        "integration"
      ]
    },
    "gemini": {
      "role": "analysis_expert",
      "command": "gemini -p",
      "responsibilities": [
        "Full codebase scanning (1M+ token context)",
        "Architecture review and pattern detection",
        "Security audits and vulnerability scanning",
        "Performance bottleneck analysis",
        "Feature gap analysis against roadmap",
        "Dependency audits and updates check",
        "Cross-file relationship mapping"
      ],
      "use_cases": [
        "codebase_analysis",
        "architecture_review",
        "security_audit",
        "performance_analysis",
        "pattern_detection",
        "feature_completeness_check"
      ],
      "context_window": "1M+ tokens",
      "privacy": "cloud"
    },
    "qwen": {
      "role": "generation_expert",
      "command": "qwen",
      "responsibilities": [
        "Fast code generation and scaffolding",
        "TypeScript interface and type creation",
        "Component and service implementation",
        "Hook and utility function generation",
        "Local code validation and review",
        "Sensitive code handling (privacy-first)"
      ],
      "use_cases": [
        "code_generation",
        "scaffolding",
        "type_definitions",
        "component_creation",
        "quick_prototyping",
        "sensitive_code_review"
      ],
      "context_window": "32K-128K tokens",
      "privacy": "local",
      "latency": "<100ms"
    }
  },
  "delegation_rules": {
    "gemini_triggers": [
      "analyze codebase",
      "scan for",
      "architecture review",
      "security audit",
      "performance analysis",
      "what exists",
      "what's missing",
      "pattern detection",
      "dependency check",
      "full project scan"
    ],
    "qwen_triggers": [
      "generate code",
      "create component",
      "write function",
      "scaffold",
      "implement",
      "build interface",
      "type definition",
      "quick prototype",
      "local review"
    ],
    "decision_tree": {
      "needs_full_codebase_context": "gemini",
      "needs_architecture_overview": "gemini",
      "needs_security_audit": "gemini",
      "needs_code_generation": "qwen",
      "needs_fast_response": "qwen",
      "handles_sensitive_code": "qwen",
      "needs_file_operations": "claude",
      "needs_implementation": "claude"
    }
  },
  "workflow_steps": [
    {
      "step": 1,
      "name": "understand_task",
      "action": "Claude analyzes user request and breaks down requirements",
      "output": "Task breakdown with clear objectives"
    },
    {
      "step": 2,
      "name": "assign_agents",
      "action": "Claude delegates to Gemini (analysis) or Qwen (generation) based on specialties",
      "output": "Agent assignments with specific prompts"
    },
    {
      "step": 3,
      "name": "collect_answers",
      "action": "User runs Gemini/Qwen commands and provides outputs",
      "output": "Raw agent responses"
    },
    {
      "step": 4,
      "name": "validate_results",
      "action": "Claude validates answers for correctness, completeness, and consistency",
      "output": "Validated insights and recommendations"
    },
    {
      "step": 5,
      "name": "final_output",
      "action": "Claude merges insights and provides final implementation plan or creates files",
      "output": "Final plan.json, commands, or file operations"
    }
  ],
  "validation_criteria": {
    "gemini_outputs": [
      "Comprehensive analysis provided",
      "Actionable insights included",
      "No hallucinations or assumptions",
      "Pattern detection is accurate",
      "Security issues clearly identified"
    ],
    "qwen_outputs": [
      "Valid TypeScript/JavaScript syntax",
      "Follows project conventions",
      "Uses design tokens from theme",
      "Proper type safety",
      "No hardcoded values"
    ],
    "final_plan": [
      "All tasks clearly defined",
      "Dependencies identified",
      "File paths are correct",
      "No conflicts with existing code",
      "Implementation steps are actionable"
    ]
  },
  "project_specific": {
    "name": "CoinKeeper",
    "framework": "React Native",
    "language": "TypeScript",
    "backend": "Firebase/Firestore",
    "animations": "Reanimated v3",
    "design_system": "src/theme/designTokens.ts",
    "conventions": {
      "spacing_grid": "4px",
      "animation_config": "{ damping: 16, stiffness: 140, mass: 1 }",
      "colors": "Use COLORS from designTokens",
      "typography": "Use TYPOGRAPHY from designTokens",
      "haptics": "Required on all interactions"
    }
  },
  "examples": {
    "gemini_task": {
      "user_request": "What's missing from the Collections module?",
      "delegation": "gemini -p '@src/screens/admin/ @GROUP_MANAGEMENT_MODULE.md Compare implemented features against roadmap. List what's missing for Collections module.'",
      "expected_output": "Gap analysis with specific missing features"
    },
    "qwen_task": {
      "user_request": "Create a TypeScript interface for Lottery Draw",
      "delegation": "qwen 'Generate TypeScript interface for Lottery Draw with fields: id, groupId, drawDate, bidAmount, participants, winner, status'",
      "expected_output": "Valid TypeScript interface definition"
    },
    "combined_workflow": {
      "user_request": "Implement Analytics Dashboard",
      "step_1": "Gemini scans: gemini -p '@src/ What charting libraries exist? What patterns should we follow?'",
      "step_2": "Qwen generates: qwen 'Create AnalyticsScreen component scaffold with charts'",
      "step_3": "Claude implements: Uses Write tool to create files based on Qwen output",
      "step_4": "Qwen validates: qwen 'Review implementation' < src/screens/admin/AnalyticsScreen.tsx",
      "step_5": "Gemini final review: gemini -p '@src/screens/admin/AnalyticsScreen.tsx Final validation'"
    }
  }
}

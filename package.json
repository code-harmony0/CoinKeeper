{
  "name": "CoinKeeper",
  "version": "0.0.1",
  "private": true,
  "op-sqlite": {
    "sqlcipher": true
  },
  "scripts": {
    "_clean:autolink": "rm -rf android/build/generated/autolinking",
    "android": "npm run android:pro",
    "android:lite": "npm run _clean:autolink && react-native run-android --mode=liteDebug --appId=com.coinkeeper.finance",
    "android:pro": "npm run _clean:autolink && CK_CHITFUND=1 react-native run-android --mode=proDebug --appId=com.coinkeeper.finance.pro",
    "build:lite": "npm run _clean:autolink && cd android && ./gradlew assembleLiteRelease",
    "build:pro": "npm run _clean:autolink && cd android && CK_CHITFUND=1 ./gradlew assembleProRelease",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "verify:split": "./scripts/verify-bundle-split.sh"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "^5.2.14",
